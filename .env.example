# Neon Serverless PostgreSQL with connection pooling
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js Secret Key
NEXTAUTH_SECRET="your-generated-super-secret-key-32-chars-minimum"
AUTH_SECRET="your-generated-super-secret-key-32-chars-minimum"
NEXTAUTH_URL="https://your-production-domain.vercel.app"

# Vercel Public Object Storage (Vercel Blob - 100% Free Tier)
# In Vercel Project Dashboard: Storage -> Create Database / Store -> Blob -> Connect Store
# Vercel automatically sets BLOB_READ_WRITE_TOKEN in Production & Preview
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
